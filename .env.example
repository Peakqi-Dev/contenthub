# ============ 核心 ============
# PostgreSQL 連線字串（Neon / Supabase / 本地皆可）
DATABASE_URL="postgresql://user:password@localhost:5432/content_hub"
# 若用 `npx prisma dev -d -n content-hub --port 51213` 的本地 DB，改用（port 以 `npx prisma dev ls` 顯示為準）：
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&pgbouncer=true"

# 32 bytes hex（64 字元），加密 DB 裡的 token 用
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ============ 平台憑證 ============
# 第一階段範圍（規格 v1.1 修訂 2）：FB 粉專 / Instagram / Threads / X / LINE OA / Medium(ASSISTED)
# 各平台 adapter 開工時再逐一補上對應變數：
# META_APP_ID= / META_APP_SECRET= / META_REDIRECT_URI=
# THREADS_APP_ID= / THREADS_APP_SECRET= / THREADS_REDIRECT_URI=
# LINE_CHANNEL_ID= / LINE_CHANNEL_SECRET= / LINE_CHANNEL_ACCESS_TOKEN=
# X_CLIENT_ID= / X_CLIENT_SECRET=
